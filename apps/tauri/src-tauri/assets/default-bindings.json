{
  "version": 1,
  "bindings": [
    {
      "command": "project.open",
      "when": { "type": "key", "key": "o", "modifiers": ["ctrl"] }
    },
    {
      "command": "records.focus-filter",
      "when": { "type": "key", "key": "p", "modifiers": ["ctrl"] }
    },
    {
      "command": "document.close_active",
      "when": { "type": "key", "key": "w", "modifiers": ["ctrl"] }
    },
    {
      "command": "document.new.notation",
      "when": { "type": "key", "key": "n", "modifiers": ["ctrl"] }
    },
    {
      "command": "document.save",
      "when": { "type": "key", "key": "s", "modifiers": ["ctrl"] }
    },
    {
      "command": "edit.undo",
      "when": { "type": "key", "key": "z", "modifiers": ["ctrl"] }
    },
    {
      "command": "edit.redo",
      "when": { "type": "key", "key": "z", "modifiers": ["ctrl", "shift"] }
    },
    {
      "command": "notation.tool.draw",
      "when": { "type": "key", "key": "d" }
    },
    {
      "command": "notation.tool.select",
      "when": { "type": "key", "key": "s" }
    },
    {
      "command": "notation.tool.erase",
      "when": { "type": "key", "key": "e" }
    },
    {
      "command": "notation.snap.toggle",
      "when": { "type": "key", "key": "n" }
    },
    {
      "command": "play.toggle",
      "when": { "type": "key", "key": "space" }
    },
    {
      "command": "notation.record.toggle",
      "when": { "type": "key", "key": "r" }
    },
    {
      "command": "settings.open",
      "when": { "type": "key", "key": ",", "modifiers": ["ctrl"] }
    }
  ]
}
